<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- /my: Odoo's alert card for unread conversations, in the notification
         centre's own category (first on /my), next to the unread notifications
         card; counted through /my/counters -->
    <template id="portal_my_home" inherit_id="woow_portal_notification.portal_my_home" name="Portal notifications: unread conversations card">
        <div id="portal_wpn_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-primary align-items-center'"/>
                <t t-set="placeholder_count" t-value="'wpn_unread_conversation_count'"/>
                <t t-set="title">Unread conversations</t>
                <t t-set="url" t-value="'/my/discussions'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
        </div>
    </template>

</odoo>
