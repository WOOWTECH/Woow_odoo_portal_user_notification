<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- User menu: a dot on the avatar and a "Notifications" entry with the
         unread count.  Computed here rather than passed by a controller so it
         is right on every page: this block is rendered per user even on
         cached website pages (t-nocache). -->
    <!-- Not hooked on the "is_connected" t-set: website rewrites it (first
         False, then the real value), so a t-set placed after it reads False. -->
    <template id="user_dropdown" inherit_id="portal.user_dropdown" name="Portal notifications: user menu">
        <xpath expr="//a[@data-bs-toggle='dropdown']" position="before">
            <t t-set="wpn_unread" t-value="user_id._wpn_unread_count()"/>
        </xpath>
        <xpath expr="//a[@data-bs-toggle='dropdown']" position="inside">
            <span t-if="wpn_unread" class="o_wpn_dot"><span class="visually-hidden">Unread notifications</span></span>
        </xpath>
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <a t-if="user_id._is_portal()" href="/my/notifications" role="menuitem"
               class="dropdown-item ps-3 d-flex align-items-center gap-1">
                <i class="fa fa-fw fa-bell-o me-1 small text-primary text-primary-emphasis"/><span>Notifications</span>
                <span t-if="wpn_unread" class="badge rounded-pill text-bg-primary ms-auto o_wpn_unread_count" t-out="wpn_unread"/>
            </a>
        </xpath>
    </template>

    <!-- /my: the greeting takes the place of the "My account" title; Odoo's
         header row (and its contact-details button on phones) stays. -->
    <template id="portal_layout" inherit_id="portal.portal_layout" name="Portal notifications: greeting">
        <xpath expr="//h3[hasclass('my-3')]" position="attributes">
            <attribute name="t-if">not wpn_greetings</attribute>
        </xpath>
        <xpath expr="//h3[hasclass('my-3')]" position="before">
            <h3 t-if="wpn_greetings" class="mt-3 mb-3 o_wpn_greeting"
                t-att-data-morning="wpn_greetings['morning']"
                t-att-data-afternoon="wpn_greetings['afternoon']"
                t-att-data-evening="wpn_greetings['evening']"
                t-out="wpn_greetings['default']"/>
        </xpath>
    </template>

    <!-- /my: notification summary above Odoo's cards -->
    <template id="portal_my_home" inherit_id="portal.portal_my_home" name="Portal notifications: home summary">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-if="wpn_summary" t-call="woow_portal_notification.home_summary"/>
        </xpath>
    </template>

    <template id="item_avatar" name="Portal notifications: item avatar">
        <span t-if="item['is_person']" class="o_wpn_avatar o_wpn_person" t-att-title="item['author']" t-out="item['initial']"/>
        <span t-else="" class="o_wpn_avatar"><i class="fa fa-bell-o" aria-hidden="true"/></span>
    </template>

    <template id="extra_entry" name="Portal notifications: extra entry">
        <span class="o_wpn_avatar"><i t-attf-class="fa #{extra['icon']}" aria-hidden="true"/></span>
        <span class="flex-grow-1 o_wpn_main">
            <span class="d-block fw-semibold" t-out="extra['title']"/>
            <span class="d-block small text-muted" t-out="extra['text']"/>
        </span>
        <i class="fa fa-angle-right text-muted" aria-hidden="true"/>
    </template>

    <template id="home_summary" name="Portal notifications: home summary card">
        <section class="card mt-3 o_wpn_summary" aria-labelledby="o_wpn_summary_title">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center gap-2 py-1">
                    <i class="fa fa-bell-o text-primary" aria-hidden="true"/>
                    <h2 id="o_wpn_summary_title" class="h6 mb-0">
                        <a href="/my/notifications" class="text-reset text-decoration-none">Notifications</a>
                    </h2>
                    <span t-if="wpn_summary['unread_count']" class="badge rounded-pill text-bg-primary o_wpn_unread_count" t-out="wpn_summary['unread_count']"/>
                    <span t-elif="not wpn_summary['extras']" class="small text-muted">No new notifications</span>
                    <a href="/my/notifications" class="ms-auto small text-nowrap">View all <i class="fa fa-angle-right" aria-hidden="true"/></a>
                </div>
                <ul t-if="wpn_summary['items'] or wpn_summary['extras']" class="list-unstyled mb-0">
                    <li t-foreach="wpn_summary['extras']" t-as="extra" class="o_wpn_summary_row">
                        <a t-att-href="extra['url']" class="d-flex align-items-center gap-2 py-2 text-reset text-decoration-none">
                            <t t-call="woow_portal_notification.extra_entry"/>
                        </a>
                    </li>
                    <li t-foreach="wpn_summary['items']" t-as="item" class="o_wpn_summary_row">
                        <a t-att-href="item['open_url']" class="d-flex align-items-center gap-2 py-2 text-reset text-decoration-none">
                            <t t-call="woow_portal_notification.item_avatar"/>
                            <span class="flex-grow-1 o_wpn_main">
                                <span class="d-block fw-semibold text-truncate" t-out="item['title']"/>
                                <span class="d-block small text-muted text-truncate"><t t-out="item['source']"/><t t-if="item['source']"> · </t><t t-out="item['time_ago']"/></span>
                            </span>
                            <i class="fa fa-angle-right text-muted" aria-hidden="true"/>
                        </a>
                    </li>
                </ul>
            </div>
        </section>
    </template>

    <template id="portal_breadcrumbs" inherit_id="portal.portal_breadcrumbs" name="Portal notifications: breadcrumb">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'wpn_notifications'" class="breadcrumb-item active">Notifications</li>
        </xpath>
    </template>

    <!-- /my/notifications -->
    <template id="portal_my_notifications" name="Portal notification centre">
        <t t-call="portal.portal_layout">
            <div class="o_wpn_page" t-att-data-open="open_id or None">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <h3 class="mb-0 me-auto">Notifications</h3>
                    <button type="button" t-attf-class="btn btn-sm btn-outline-primary o_wpn_read_all #{'' if unread_count else 'd-none'}"
                            t-att-data-search="search or ''">
                        <i class="fa fa-check me-1" aria-hidden="true"/>Mark all as read
                    </button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <div class="btn-group btn-group-sm" role="group">
                        <a t-attf-class="btn #{'btn-primary' if filterby == 'all' else 'btn-outline-primary'}"
                           t-attf-href="/my/notifications?#{keep_query('search')}">All</a>
                        <a t-attf-class="btn #{'btn-primary' if filterby == 'unread' else 'btn-outline-primary'}"
                           t-attf-href="/my/notifications?#{keep_query('search', filterby='unread')}">
                            Unread
                            <span t-attf-class="badge rounded-pill ms-1 o_wpn_unread_count #{'text-bg-light' if filterby == 'unread' else 'text-bg-primary'} #{'' if unread_count else 'd-none'}"
                                  t-out="unread_count"/>
                        </a>
                    </div>
                    <form class="ms-sm-auto o_wpn_search" method="get" action="/my/notifications" role="search">
                        <input t-if="filterby != 'all'" type="hidden" name="filterby" t-att-value="filterby"/>
                        <div class="input-group input-group-sm">
                            <input type="search" name="search" class="form-control" t-att-value="search"
                                   placeholder="Search notifications" aria-label="Search notifications"/>
                            <button class="btn btn-outline-secondary" type="submit" title="Search" aria-label="Search">
                                <i class="fa fa-search" aria-hidden="true"/>
                            </button>
                        </div>
                    </form>
                </div>

                <div t-if="extras" class="list-group mb-3">
                    <a t-foreach="extras" t-as="extra" t-att-href="extra['url']"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <t t-call="woow_portal_notification.extra_entry"/>
                    </a>
                </div>

                <div t-if="items" class="list-group o_wpn_list">
                    <div t-foreach="items" t-as="item" t-att-data-id="item['id']"
                         t-attf-class="list-group-item d-flex align-items-start gap-3 o_wpn_item #{'' if item['is_read'] else 'o_wpn_unread'}">
                        <t t-call="woow_portal_notification.item_avatar"/>
                        <div class="flex-grow-1 o_wpn_main">
                            <a t-if="item['url']" t-att-href="item['open_url']"
                               class="d-block text-reset text-decoration-none stretched-link o_wpn_title" t-out="item['title']"/>
                            <button t-else="" type="button" t-att-data-id="item['id']"
                                    data-bs-toggle="modal" data-bs-target="#o_wpn_modal"
                                    class="btn btn-link d-block p-0 border-0 text-reset text-decoration-none text-start stretched-link o_wpn_title"
                                    t-out="item['title']"/>
                            <div class="small text-muted">
                                <t t-out="item['source']"/><t t-if="item['source']"> · </t><span t-att-title="item['date']" t-out="item['time_ago']"/>
                            </div>
                            <div t-if="item['preview']" class="small o_wpn_preview" t-out="item['preview']"/>
                        </div>
                        <button type="button" class="btn btn-link btn-sm o_wpn_toggle o_wpn_when_unread"
                                title="Mark as read" aria-label="Mark as read">
                            <i class="fa fa-envelope" aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-link btn-sm o_wpn_toggle o_wpn_when_read"
                                title="Mark as unread" aria-label="Mark as unread">
                            <i class="fa fa-envelope-open-o" aria-hidden="true"/>
                        </button>
                    </div>
                </div>
                <div t-else="" class="text-center text-muted py-5 o_wpn_empty">
                    <i class="fa fa-bell-o fa-2x d-block mb-3" aria-hidden="true"/>
                    <p t-if="search" class="mb-0">No matching notifications.</p>
                    <p t-elif="filterby == 'unread'" class="mb-0">No unread notifications.</p>
                    <p t-else="" class="mb-0">No notifications yet. Updates about your orders, projects and other documents will appear here.</p>
                </div>

                <div t-if="pager['page_count'] &gt; 1" class="o_portal_pager d-flex justify-content-center mt-3">
                    <t t-call="portal.pager"/>
                </div>

                <!-- the message of a notification whose document has no page -->
                <div class="modal fade" id="o_wpn_modal" tabindex="-1" aria-labelledby="o_wpn_modal_title" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="o_wpn_modal_title"/>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body o_wpn_modal_body"/>
                        </div>
                    </div>
                </div>
                <div t-foreach="modal_items" t-as="item" class="d-none o_wpn_body_src"
                     t-att-data-id="item['id']" t-att-data-title="item['title']">
                    <p class="small text-muted">
                        <t t-out="item['source']"/><t t-if="item['source']"> · </t><t t-out="item['date']"/><t t-if="item['author']"> · <t t-out="item['author']"/></t>
                    </p>
                    <div t-if="item['body']" class="o_wpn_body" t-out="item['body']"/>
                    <table t-if="item['tracking']" class="table table-sm mb-0">
                        <tbody>
                            <tr t-foreach="item['tracking']" t-as="row">
                                <th scope="row" class="fw-normal text-muted" t-out="row['field']"/>
                                <td><t t-if="row['old']"><t t-out="row['old']"/> → </t><t t-out="row['new'] or '—'"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <button t-if="open_id" type="button" class="d-none" t-att-data-id="open_id"
                        data-bs-toggle="modal" data-bs-target="#o_wpn_modal"/>
            </div>
        </t>
    </template>

</odoo>
