<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- User menu: a "Notifications" entry, and the unread count next to the
         avatar / name, shaped like the cart and wishlist counters.  Computed
         here, not passed by a controller, so it is right on every page: this
         block is rendered per user even on cached website pages (t-nocache).
         Not hooked on the "is_connected" t-set: website rewrites it (first
         False, then the real value), so a t-set placed after it reads False. -->
    <template id="user_dropdown" inherit_id="portal.user_dropdown" name="Portal notifications: user menu">
        <xpath expr="//a[@data-bs-toggle='dropdown']" position="before">
            <t t-set="wpn_unread" t-value="user_id._wpn_unread_count()"/>
        </xpath>
        <xpath expr="//a[@data-bs-toggle='dropdown']" position="inside">
            <sup t-if="wpn_unread" class="badge rounded-pill bg-primary ms-1 o_wpn_unread_count"
                 aria-label="Number of unread notifications" t-out="wpn_unread"/>
        </xpath>
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <a t-if="user_id._is_portal()" href="/my/notifications" role="menuitem" class="dropdown-item ps-3">
                <i class="fa fa-fw fa-bell-o me-1 small text-primary text-primary-emphasis"/> Notifications
                <span t-if="wpn_unread" class="badge rounded-pill text-bg-primary ms-1 o_wpn_unread_count" t-out="wpn_unread"/>
            </a>
        </xpath>
    </template>

    <!-- /my: the greeting takes the place of the "My account" title; Odoo's
         header row (and its contact-details button on phones) stays. -->
    <template id="portal_layout" inherit_id="portal.portal_layout" name="Portal notifications: greeting">
        <xpath expr="//h3[hasclass('my-3')]" position="attributes">
            <attribute name="t-if">not wpn_greetings</attribute>
        </xpath>
        <xpath expr="//h3[hasclass('my-3')]" position="before">
            <h3 t-if="wpn_greetings" class="mt-3 mb-3 o_wpn_greeting"
                t-att-data-morning="wpn_greetings['morning']"
                t-att-data-afternoon="wpn_greetings['afternoon']"
                t-att-data-evening="wpn_greetings['evening']"
                t-out="wpn_greetings['default']"/>
        </xpath>
    </template>

    <!-- /my: Odoo's own cards.  The counts come from /my/counters like every
         other card; a card with nothing to count stays hidden. -->
    <template id="portal_my_home" inherit_id="portal.portal_my_home" name="Portal notifications: home cards">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_alert_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_alert_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="bg_color" t-value="'alert alert-primary align-items-center'"/>
                <t t-set="placeholder_count" t-value="'wpn_unread_count'"/>
                <t t-set="title">Unread notifications</t>
                <t t-set="url" t-value="'/my/notifications?filterby=unread'"/>
                <t t-set="show_count" t-value="True"/>
            </t>
        </div>
        <div id="portal_common_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/woow_portal_notification/static/src/img/notifications.svg'"/>
                <t t-set="title">Notifications</t>
                <t t-set="url" t-value="'/my/notifications'"/>
                <t t-set="text">Updates about your orders, projects and other documents</t>
                <t t-set="placeholder_count" t-value="'wpn_notification_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs" inherit_id="portal.portal_breadcrumbs" name="Portal notifications: breadcrumb">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'wpn_notifications'" class="breadcrumb-item active">Notifications</li>
        </xpath>
    </template>

    <!-- /my/notifications: Odoo's portal search bar, table and pager, like the
         orders or invoices list -->
    <template id="portal_my_notifications" name="Portal notification centre">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_wpn_page" t-att-data-open="open_id or None">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Notifications</t>
                </t>

                <!-- All / Unread / Read, always in view (the search bar folds its
                     filters away on phones) -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <ul class="nav nav-pills o_wpn_filters">
                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if filterby == 'all' else ''}"
                               t-attf-href="/my/notifications?#{keep_query('search')}">All</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if filterby == 'unread' else ''}"
                               t-attf-href="/my/notifications?#{keep_query('search', filterby='unread')}">
                                Unread <span t-attf-class="badge rounded-pill ms-1 o_wpn_unread_count #{'text-bg-light' if filterby == 'unread' else 'text-bg-primary'} #{'' if unread_count else 'd-none'}" t-out="unread_count"/>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if filterby == 'read' else ''}"
                               t-attf-href="/my/notifications?#{keep_query('search', filterby='read')}">Read</a>
                        </li>
                    </ul>
                    <div t-attf-class="ms-auto o_wpn_read_all_wrap #{'' if unread_count else 'd-none'}">
                        <button type="button" class="btn btn-light o_wpn_read_all" t-att-data-search="search or ''">
                            <i class="fa fa-check me-1" aria-hidden="true"/>Mark all as read
                        </button>
                    </div>
                </div>

                <div t-foreach="extras" t-as="extra" role="status"
                     class="alert alert-info d-flex flex-wrap align-items-center gap-2">
                    <i t-attf-class="fa fa-fw #{extra['icon']}" aria-hidden="true"/>
                    <span class="me-auto" t-out="extra['text']"/>
                    <a t-att-href="extra['url']" class="alert-link" t-out="extra['link_label']"/>
                </div>

                <div t-if="not items" class="alert alert-warning" role="alert">
                    <t t-if="search">No notifications match your search.</t>
                    <t t-elif="filterby == 'unread'">You have no unread notifications.</t>
                    <t t-elif="filterby == 'read'">You have no read notifications.</t>
                    <t t-else="">There are currently no notifications for your account.</t>
                </div>
                <t t-if="items" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Notification</th>
                            <th class="text-end">Date</th>
                            <th class="text-end"><span class="visually-hidden">Read</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="items" t-as="item" t-att-data-id="item['id']"
                            t-attf-class="o_wpn_item #{'' if item['is_read'] else 'o_wpn_unread'}">
                            <td class="o_wpn_main">
                                <a t-if="item['url']" t-att-href="item['open_url']" class="o_wpn_title" t-out="item['title']"/>
                                <a t-else="" href="#" role="button" t-att-data-id="item['id']"
                                   data-bs-toggle="modal" data-bs-target="#o_wpn_modal" class="o_wpn_title" t-out="item['title']"/>
                                <span class="badge rounded-pill text-bg-primary ms-1 o_wpn_unread_badge">Unread</span>
                                <div class="small text-muted">
                                    <i t-attf-class="fa fa-fw #{'fa-comment-o' if item['is_person'] else 'fa-bell-o'}" aria-hidden="true"/>
                                    <t t-out="item['source']"/><t t-if="item['author']"> · <t t-out="item['author']"/></t>
                                </div>
                                <div t-if="item['preview']" class="small text-muted o_wpn_preview" t-out="item['preview']"/>
                            </td>
                            <td class="text-end text-nowrap" t-att-title="item['date']">
                                <span class="d-md-none" t-out="item['day_short']"/>
                                <span class="d-none d-md-inline"><t t-out="item['day']"/> <t t-out="item['time']"/></span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-link btn-sm p-0 o_wpn_toggle o_wpn_when_unread"
                                        title="Mark as read" aria-label="Mark as read">
                                    <i class="fa fa-envelope" aria-hidden="true"/>
                                </button>
                                <button type="button" class="btn btn-link btn-sm p-0 o_wpn_toggle o_wpn_when_read"
                                        title="Mark as unread" aria-label="Mark as unread">
                                    <i class="fa fa-envelope-open-o" aria-hidden="true"/>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </t>

                <!-- the message of a notification whose document has no page -->
                <div class="modal fade" id="o_wpn_modal" tabindex="-1" aria-labelledby="o_wpn_modal_title" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="o_wpn_modal_title"/>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body o_wpn_modal_body"/>
                        </div>
                    </div>
                </div>
                <!-- in <template> elements: nothing in a message (a remote image)
                     loads before its dialog is opened -->
                <template t-foreach="modal_items" t-as="item" class="o_wpn_body_src"
                          t-att-data-id="item['id']" t-att-data-title="item['title']">
                    <p class="small text-muted">
                        <t t-out="item['source']"/><t t-if="item['source']"> · </t><t t-out="item['date']"/><t t-if="item['author']"> · <t t-out="item['author']"/></t>
                    </p>
                    <div t-if="item['body']" class="o_wpn_body" t-out="item['body']"/>
                    <table t-if="item['tracking']" class="table table-sm mb-0">
                        <tbody>
                            <tr t-foreach="item['tracking']" t-as="row">
                                <th scope="row" class="fw-normal text-muted" t-out="row['field']"/>
                                <td><t t-if="row['old']"><t t-out="row['old']"/> → </t><t t-out="row['new'] or '—'"/></td>
                            </tr>
                        </tbody>
                    </table>
                </template>
                <button t-if="open_id" type="button" class="d-none" t-att-data-id="open_id"
                        data-bs-toggle="modal" data-bs-target="#o_wpn_modal"/>
            </div>
        </t>
    </template>

</odoo>
